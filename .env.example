# Port du serveur local
PORT=4600

# Accès à distance (Tailscale) : HOST=0.0.0.0 pour piloter le studio depuis
# ton téléphone ou un autre appareil du réseau privé. Défaut : ce Mac seulement.
# HOST=0.0.0.0

# Fournisseur d'images :
#   openart      → ton compte OpenArt via le MCP officiel (meilleure qualité + visages constants).
#                  Prérequis : claude mcp add --transport http --scope user openart https://mcp.openart.ai/mcp
#                  puis authentification une fois via `claude` → /mcp → openart.
#   pollinations → gratuit, sans compte (par défaut)
#   fal          → fal.ai FLUX (clé requise)
#   manual       → aucune génération auto, import à la main
IMAGE_PROVIDER=pollinations

# Nom du serveur MCP OpenArt si différent de "openart" (voir `claude mcp list`)
# OPENART_MCP_NAME=openart

# Forcer UN modèle vidéo OpenArt précis (sinon : le moins cher acceptable,
# versions Pro/Master/Omni interdites). Ex. : OPENART_VIDEO_MODEL=Seedance
# OPENART_VIDEO_MODEL=

# Clips vidéo automatiques (OpenArt uniquement) : la 1re scène, celle du milieu
# et la dernière de chaque épisode sont animées en vidéo (image-to-video).
# Attention : une vidéo coûte nettement plus de crédits qu'une image.
# VIDEO_SCENES=off  → désactive (tout reste en images animées Ken Burns)
# VIDEO_SCENES=on

# Clé fal.ai — nécessaire à la synchro labiale du Format long (lèvres animées
# sur les voix, payant à l'usage) et pour IMAGE_PROVIDER=fal —
# https://fal.ai/dashboard/keys
FAL_KEY=
# Modèle fal.ai images (optionnel, défaut : fal-ai/flux/dev)
# FAL_MODEL=fal-ai/flux/dev
# Modèle fal.ai de synchro labiale (défaut : fal-ai/sync-lipsync/v2, 3 $/min).
# Compare les moteurs avec la carte « 🧪 Test synchro » de l'accueil avant de
# changer. Choix notables : fal-ai/sync-lipsync/v2/pro (5 $/min, gros plans),
# fal-ai/bytedance/omnihuman/v1.5 (génération DIRECTE image+voix : visage
# entier cohérent, durée = durée des paroles, 0,16 $/s — plus de clip OpenArt
# à payer sur les scènes parlées), veed/lipsync.
# FAL_LIPSYNC_MODEL=fal-ai/sync-lipsync/v2
# Quand la voix dure plus que le clip : bounce (défaut, le clip se prolonge
# en aller-retour fluide), loop, ou cut_off (coupe à la fin du clip)
# FAL_LIPSYNC_SYNC_MODE=bounce

# Voix : auto (défaut) = ElevenLabs si clé, sinon Edge TTS, sinon voix macOS.
# Forcer un moteur : elevenlabs | edge | say
# TTS_PROVIDER=auto

# Clé ElevenLabs — la meilleure qualité de voix (https://elevenlabs.io → profil → API Keys)
# Astuce : la carte « 🇫🇷 Voix françaises » de l'accueil permet d'adopter de
# vraies voix natives françaises de la bibliothèque (plan payant requis) —
# elles s'ajoutent aux menus et au casting automatique.
# ELEVENLABS_API_KEY=

# Modèle ElevenLabs. Défaut : eleven_multilingual_v2 — accent français
# d'Europe correct, langue ancrée en français par un contexte (anti-bascule
# vers l'anglais). eleven_turbo_v2_5 = 2× moins cher et français imposé,
# MAIS accent québécois sur ces voix anglophones — à éviter.
# ELEVEN_MODEL=eleven_multilingual_v2

# Dossier d'export des épisodes validés (défaut : ~/Desktop/Dramas)
# EXPORT_DIR=icloud  → iCloud Drive/Dramas (synchronisé iPhone/iPad)
# EXPORT_DIR=/un/autre/chemin  → dossier de ton choix (~/ accepté)
# Ex. : EXPORT_DIR=~/Library/Mobile Documents/com~apple~CloudDocs/Mon Dossier/Dramas
# EXPORT_DIR=

# Chemin d'un Chromium/Chrome spécifique pour le rendu Remotion (optionnel)
# REMOTION_BROWSER_EXECUTABLE=

# Chemin de la commande claude si l'appli ne la trouve pas toute seule
# (elle cherche déjà : ~/.claude/local, Homebrew, npm global, nvm…)
# CLAUDE_BIN=/opt/homebrew/bin/claude
